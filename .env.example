# Port, auf dem die App auf dem Docker-Host erreichbar ist
HOST_PORT=3400

# Wie oft der Store gescannt wird (Minuten). Sales in Star Citizen ändern
# sich nicht minütlich -- 180 (alle 3h) ist ein guter, rücksichtsvoller Default.
SCAN_INTERVAL_MINUTES=180

# Pause zwischen einzelnen Requests an robertsspaceindustries.com (ms).
# Bei ~253 Store-Items und ~26 Listing-Seiten sind das ~280 Requests pro
# Scan -- 400ms Pause ergibt ca. 2 Minuten Scan-Dauer, unauffällig für RSI.
SCAN_REQUEST_DELAY_MS=400
